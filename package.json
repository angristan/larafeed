{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite",
        "build": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
        "build:test": "CLOUDFLARE_ENV=test CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
        "preview": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite preview",
        "dev:cloudflare": "npm run dev",
        "build:cloudflare": "npm run build",
        "preview:cloudflare": "npm run preview",
        "lint-check": "biome check --no-errors-on-unmatched",
        "typecheck": "tsc --noEmit",
        "typecheck:cloudflare": "npm run typecheck",
        "types:cloudflare": "wrangler types --env-file .dev.vars.example --strict-vars false",
        "types:check:cloudflare": "wrangler types --env-file .dev.vars.example --strict-vars false --check",
        "d1:migrate:local": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler d1 migrations apply DB --local --env-file .dev.vars.example",
        "auth:access-link": "bun scripts/auth-access-link.ts",
        "d1:validate": "bun scripts/cloudflare-validation/run.ts --profile ci --output-dir scripts/cloudflare-validation/output",
        "d1:validate:large": "bun scripts/cloudflare-validation/run.ts --profile large --output-dir scripts/cloudflare-validation/output",
        "deploy:check": "npm run build && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --dry-run",
        "deploy:check:test": "npm run build:test && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --dry-run",
        "deploy:test": "npm run build:test && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy",
        "deploy:check:cloudflare": "npm run deploy:check",
        "test": "vitest run --config vitest.config.ts && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run --config vitest.worker.config.ts",
        "test:cloudflare": "npm test"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@cloudflare/vite-plugin": "1.50.0",
        "@cloudflare/vitest-pool-workers": "0.20.1",
        "@effect/vitest": "4.0.0-beta.102",
        "@gfazioli/mantine-split-pane": "^1.1.5",
        "@mantine/core": "^9.0.2",
        "@mantine/hooks": "^9.0.2",
        "@mantine/modals": "^9.0.2",
        "@mantine/notifications": "^9.0.2",
        "@tabler/icons-react": "^3.44.0",
        "@types/node": "^25.9.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.5.0",
        "postcss": "8.5.25",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "typescript": "^6.0.3",
        "vite": "7.3.6",
        "vitest": "4.1.10",
        "wrangler": "4.118.0"
    },
    "dependencies": {
        "@mantine/charts": "9.0.2",
        "@mantine/spotlight": "9.0.2",
        "@simplewebauthn/browser": "13.3.0",
        "@simplewebauthn/server": "13.3.2",
        "@tanstack/react-query": "5.101.4",
        "effect": "4.0.0-beta.102",
        "fast-xml-parser": "5.10.1",
        "hono": "4.12.33",
        "react-router": "8.3.0",
        "recharts": "3.8.1"
    }
}
