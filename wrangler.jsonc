{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "larafeed",
    "main": "./worker/index.ts",
    "compatibility_date": "2026-07-18",
    "compatibility_flags": ["nodejs_compat"],
    "vars": {
        "AUTH_ENVIRONMENT": "production",
        "AUTH_RP_ID": "larafeed.stanislas.cloud",
        "AUTH_ORIGIN": "https://larafeed.stanislas.cloud",
        "AUTH_RP_NAME": "Larafeed",
        "AUTH_CHALLENGE_TTL_SECONDS": "300",
        "AUTH_SESSION_TTL_SECONDS": "2592000",
        "AI_SUMMARY_ENABLED": "false",
        "AI_GATEWAY_NAME": "larafeed",
        "AI_MODEL": "gemini-2.5-flash",
        "REFRESH_SCHEDULER_ENABLED": "true",
        "REFRESH_DISPATCH_ENABLED": "true",
        "REFRESH_DUE_LIMIT": "10",
        "OPML_IMPORT_ENABLED": "true",
        "FAVICON_REFRESH_ENABLED": "true",
        "IMAGES_ENABLED": "true"
    },
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/export", "/up"]
    },
    "images": { "binding": "IMAGES" },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "larafeed",
            "database_id": "00000000-0000-0000-0000-000000000001",
            "migrations_dir": "migrations"
        }
    ],
    "ratelimits": [
        {
            "name": "AUTH_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 20, "period": 60 }
        }
    ],
    "queues": {
        "producers": [
            {
                "binding": "FEED_REFRESH_QUEUE",
                "queue": "larafeed-feed-refresh"
            },
            {
                "binding": "OPML_IMPORT_QUEUE",
                "queue": "larafeed-opml-import"
            }
        ],
        "consumers": [
            {
                "queue": "larafeed-feed-refresh",
                "max_batch_size": 5,
                "max_batch_timeout": 5,
                "max_retries": 5,
                "dead_letter_queue": "larafeed-feed-refresh-dlq",
                "max_concurrency": 3
            },
            {
                "queue": "larafeed-feed-refresh-dlq",
                "max_batch_size": 5,
                "max_batch_timeout": 5,
                "max_retries": 2,
                "max_concurrency": 1
            },
            {
                "queue": "larafeed-opml-import",
                "max_batch_size": 10,
                "max_batch_timeout": 5,
                "max_retries": 5,
                "dead_letter_queue": "larafeed-opml-import-dlq",
                "max_concurrency": 2
            },
            {
                "queue": "larafeed-opml-import-dlq",
                "max_batch_size": 10,
                "max_batch_timeout": 5,
                "max_retries": 2,
                "max_concurrency": 1
            }
        ]
    },
    "triggers": { "crons": ["*/5 * * * *"] },
    "env": {
        "test": {
            "vars": {
                "AUTH_ENVIRONMENT": "test",
                "AUTH_RP_ID": "larafeedcf.stanislas.cloud",
                "AUTH_ORIGIN": "https://larafeedcf.stanislas.cloud",
                "AUTH_RP_NAME": "Larafeed Test",
                "AUTH_CHALLENGE_TTL_SECONDS": "300",
                "AUTH_SESSION_TTL_SECONDS": "2592000",
                "AI_SUMMARY_ENABLED": "false",
                "AI_GATEWAY_ACCOUNT_ID": "00000000000000000000000000000000",
                "AI_GATEWAY_NAME": "larafeed-test",
                "GEMINI_API_KEY": "test-only-not-a-real-secret",
                "AI_MODEL": "gemini-2.5-flash",
                "REFRESH_SCHEDULER_ENABLED": "false",
                "REFRESH_DISPATCH_ENABLED": "false",
                "REFRESH_DUE_LIMIT": "5",
                "OPML_IMPORT_ENABLED": "false",
                "FAVICON_REFRESH_ENABLED": "false",
                "IMAGES_ENABLED": "true"
            },
            "routes": [
                {
                    "pattern": "larafeedcf.stanislas.cloud",
                    "custom_domain": true
                }
            ],
            "observability": {
                "enabled": true,
                "logs": {
                    "enabled": false,
                    "head_sampling_rate": 0,
                    "invocation_logs": false,
                    "persist": false
                },
                "traces": {
                    "enabled": true,
                    "head_sampling_rate": 1,
                    "persist": true
                }
            },
            "images": { "binding": "IMAGES" },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "larafeed-test",
                    "database_id": "05458985-c8cf-4925-adea-7508e05196b3",
                    "migrations_dir": "migrations"
                }
            ],
            "ratelimits": [
                {
                    "name": "AUTH_RATE_LIMITER",
                    "namespace_id": "1002",
                    "simple": { "limit": 1000, "period": 60 }
                }
            ],
            "queues": {
                "producers": [
                    {
                        "binding": "FEED_REFRESH_QUEUE",
                        "queue": "larafeed-test-feed-refresh"
                    },
                    {
                        "binding": "OPML_IMPORT_QUEUE",
                        "queue": "larafeed-test-opml-import"
                    }
                ],
                "consumers": [
                    {
                        "queue": "larafeed-test-feed-refresh",
                        "max_batch_size": 5,
                        "max_batch_timeout": 5,
                        "max_retries": 5,
                        "dead_letter_queue": "larafeed-test-feed-refresh-dlq",
                        "max_concurrency": 2
                    },
                    {
                        "queue": "larafeed-test-feed-refresh-dlq",
                        "max_batch_size": 5,
                        "max_batch_timeout": 5,
                        "max_retries": 2,
                        "max_concurrency": 1
                    },
                    {
                        "queue": "larafeed-test-opml-import",
                        "max_batch_size": 10,
                        "max_batch_timeout": 5,
                        "max_retries": 5,
                        "dead_letter_queue": "larafeed-test-opml-import-dlq",
                        "max_concurrency": 2
                    },
                    {
                        "queue": "larafeed-test-opml-import-dlq",
                        "max_batch_size": 10,
                        "max_batch_timeout": 5,
                        "max_retries": 2,
                        "max_concurrency": 1
                    }
                ]
            },
            "triggers": { "crons": ["*/10 * * * *"] }
        }
    }
}
