{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "larafeed-template",
    "main": "./src/worker/index.ts",
    "compatibility_date": "2026-07-18",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "preview_urls": true,
    "placement": { "mode": "smart" },
    "secrets": { "required": ["AUTH_OPERATOR_SECRET"] },
    "vars": {
        "AUTH_ENVIRONMENT": "production",
        "AUTH_ORIGIN": "https://larafeed.example.com",
        "AUTH_RP_NAME": "Larafeed",
        "AUTH_CHALLENGE_TTL_SECONDS": "300",
        "AUTH_SESSION_TTL_SECONDS": "2592000",
        "TURNSTILE_ENABLED": "false",
        "AI_SUMMARY_ENABLED": "false",
        "AI_GATEWAY_NAME": "larafeed",
        "AI_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "FULL_CONTENT_ENABLED": "true",
        "REFRESH_SCHEDULER_ENABLED": "true",
        "REFRESH_DISPATCH_ENABLED": "true",
        "REFRESH_DUE_LIMIT": "5",
        "OPML_IMPORT_ENABLED": "true",
        "FAVICON_REFRESH_ENABLED": "false",
        "IMAGES_ENABLED": "false",
        "FEED_REFRESH_QUEUE_NAME": "larafeed-template-feed-refresh",
        "OPML_IMPORT_QUEUE_NAME": "larafeed-template-opml-import",
        "FAVICON_REFRESH_QUEUE_NAME": "larafeed-template-favicon-refresh"
    },
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/export", "/up"]
    },
    "images": { "binding": "IMAGES" },
    "ai": { "binding": "AI" },
    "kv_namespaces": [
        {
            "binding": "FULL_CONTENT_KV",
            "id": "00000000000000000000000000000010"
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "larafeed-template",
            "database_id": "00000000-0000-0000-0000-000000000010",
            "migrations_dir": "migrations"
        }
    ],
    "ratelimits": [
        {
            "name": "AUTH_RATE_LIMITER",
            "namespace_id": "9001",
            "simple": { "limit": 20, "period": 60 }
        }
    ],
    "queues": {
        "producers": [
            {
                "binding": "FEED_REFRESH_QUEUE",
                "queue": "larafeed-template-feed-refresh"
            },
            {
                "binding": "OPML_IMPORT_QUEUE",
                "queue": "larafeed-template-opml-import"
            },
            {
                "binding": "FAVICON_REFRESH_QUEUE",
                "queue": "larafeed-template-favicon-refresh"
            }
        ],
        "consumers": [
            {
                "queue": "larafeed-template-feed-refresh",
                "max_batch_size": 1,
                "max_batch_timeout": 1,
                "max_retries": 5,
                "max_concurrency": 2
            },
            {
                "queue": "larafeed-template-opml-import",
                "max_batch_size": 1,
                "max_batch_timeout": 1,
                "max_retries": 5,
                "max_concurrency": 1
            },
            {
                "queue": "larafeed-template-favicon-refresh",
                "max_batch_size": 1,
                "max_batch_timeout": 1,
                "max_retries": 5,
                "max_concurrency": 1
            }
        ]
    },
    "triggers": { "crons": ["*/10 * * * *"] },
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        }
    },
    "env": {
        "production": {
            "name": "larafeed",
            "workers_dev": false,
            "preview_urls": false,
            "placement": { "mode": "smart" },
            "secrets": { "required": ["AUTH_OPERATOR_SECRET"] },
            "vars": {
                "AUTH_ENVIRONMENT": "production",
                "AUTH_ORIGIN": "https://larafeed.stanislas.cloud",
                "AUTH_RP_NAME": "Larafeed",
                "AUTH_CHALLENGE_TTL_SECONDS": "300",
                "AUTH_SESSION_TTL_SECONDS": "2592000",
                "TURNSTILE_ENABLED": "false",
                "AI_SUMMARY_ENABLED": "true",
                "AI_GATEWAY_NAME": "larafeed",
                "AI_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
                "FULL_CONTENT_ENABLED": "true",
                "REFRESH_SCHEDULER_ENABLED": "true",
                "REFRESH_DISPATCH_ENABLED": "true",
                "REFRESH_DUE_LIMIT": "10",
                "OPML_IMPORT_ENABLED": "true",
                "FAVICON_REFRESH_ENABLED": "true",
                "IMAGES_ENABLED": "true",
                "FEED_REFRESH_QUEUE_NAME": "larafeed-feed-refresh",
                "OPML_IMPORT_QUEUE_NAME": "larafeed-opml-import",
                "FAVICON_REFRESH_QUEUE_NAME": "larafeed-favicon-refresh"
            },
            "routes": [
                {
                    "pattern": "larafeed.stanislas.cloud",
                    "custom_domain": true
                }
            ],
            "images": { "binding": "IMAGES" },
            "ai": { "binding": "AI" },
            "kv_namespaces": [
                {
                    "binding": "FULL_CONTENT_KV",
                    "id": "8cc40ea7073d41e18eedc731826a0afe"
                }
            ],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "larafeed",
                    "database_id": "f22a3327-4f5f-4a5c-9aa9-3ede8ba03796",
                    "migrations_dir": "migrations"
                }
            ],
            "ratelimits": [
                {
                    "name": "AUTH_RATE_LIMITER",
                    "namespace_id": "1001",
                    "simple": { "limit": 20, "period": 60 }
                }
            ],
            "queues": {
                "producers": [
                    {
                        "binding": "FEED_REFRESH_QUEUE",
                        "queue": "larafeed-feed-refresh"
                    },
                    {
                        "binding": "OPML_IMPORT_QUEUE",
                        "queue": "larafeed-opml-import"
                    },
                    {
                        "binding": "FAVICON_REFRESH_QUEUE",
                        "queue": "larafeed-favicon-refresh"
                    }
                ],
                "consumers": [
                    {
                        "queue": "larafeed-feed-refresh",
                        "max_batch_size": 1,
                        "max_batch_timeout": 1,
                        "max_retries": 5,
                        "max_concurrency": 3
                    },
                    {
                        "queue": "larafeed-opml-import",
                        "max_batch_size": 1,
                        "max_batch_timeout": 1,
                        "max_retries": 5,
                        "max_concurrency": 1
                    },
                    {
                        "queue": "larafeed-favicon-refresh",
                        "max_batch_size": 1,
                        "max_batch_timeout": 1,
                        "max_retries": 5,
                        "max_concurrency": 1
                    }
                ]
            },
            "triggers": { "crons": ["*/5 * * * *"] },
            "observability": {
                "enabled": true,
                "logs": {
                    "enabled": true,
                    "head_sampling_rate": 1,
                    "invocation_logs": true,
                    "persist": true
                },
                "traces": {
                    "enabled": true,
                    "head_sampling_rate": 1,
                    "persist": true
                }
            }
        },
        "vitest": {
            "secrets": { "required": ["AUTH_OPERATOR_SECRET"] },
            "vars": {
                "AUTH_ENVIRONMENT": "test",
                "AUTH_ORIGIN": "https://larafeedcf.stanislas.cloud",
                "AUTH_RP_NAME": "Larafeed Test",
                "AUTH_CHALLENGE_TTL_SECONDS": "300",
                "AUTH_SESSION_TTL_SECONDS": "2592000",
                "TURNSTILE_ENABLED": "false",
                "AI_SUMMARY_ENABLED": "false",
                "AI_GATEWAY_NAME": "larafeed-test",
                "AI_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
                "FULL_CONTENT_ENABLED": "true",
                "REFRESH_SCHEDULER_ENABLED": "true",
                "REFRESH_DISPATCH_ENABLED": "true",
                "REFRESH_DUE_LIMIT": "5",
                "OPML_IMPORT_ENABLED": "true",
                "FAVICON_REFRESH_ENABLED": "true",
                "IMAGES_ENABLED": "true",
                "FEED_REFRESH_QUEUE_NAME": "larafeed-test-feed-refresh",
                "OPML_IMPORT_QUEUE_NAME": "larafeed-test-opml-import",
                "FAVICON_REFRESH_QUEUE_NAME": "larafeed-test-favicon-refresh"
            },
            "images": { "binding": "IMAGES" },
            "ai": { "binding": "AI" },
            "kv_namespaces": [
                {
                    "binding": "FULL_CONTENT_KV",
                    "id": "00000000000000000000000000000011"
                }
            ],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "larafeed-test",
                    "database_id": "05458985-c8cf-4925-adea-7508e05196b3",
                    "migrations_dir": "migrations"
                }
            ],
            "ratelimits": [
                {
                    "name": "AUTH_RATE_LIMITER",
                    "namespace_id": "1002",
                    "simple": { "limit": 1000, "period": 60 }
                }
            ],
            "queues": {
                "producers": [
                    {
                        "binding": "FEED_REFRESH_QUEUE",
                        "queue": "larafeed-test-feed-refresh"
                    },
                    {
                        "binding": "OPML_IMPORT_QUEUE",
                        "queue": "larafeed-test-opml-import"
                    },
                    {
                        "binding": "FAVICON_REFRESH_QUEUE",
                        "queue": "larafeed-test-favicon-refresh"
                    }
                ],
                "consumers": [
                    {
                        "queue": "larafeed-test-feed-refresh",
                        "max_batch_size": 1,
                        "max_batch_timeout": 1,
                        "max_retries": 5,
                        "max_concurrency": 2
                    },
                    {
                        "queue": "larafeed-test-opml-import",
                        "max_batch_size": 1,
                        "max_batch_timeout": 1,
                        "max_retries": 5,
                        "max_concurrency": 1
                    },
                    {
                        "queue": "larafeed-test-favicon-refresh",
                        "max_batch_size": 1,
                        "max_batch_timeout": 1,
                        "max_retries": 5,
                        "max_concurrency": 1
                    }
                ]
            }
        }
    }
}
