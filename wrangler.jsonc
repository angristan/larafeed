{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "larafeed",
    "main": "./worker/index.ts",
    "compatibility_date": "2026-07-18",
    "compatibility_flags": ["nodejs_compat"],
    "vars": {
        "AUTH_ENVIRONMENT": "production",
        "AUTH_RP_ID": "larafeed.stanislas.cloud",
        "AUTH_ORIGIN": "https://larafeed.stanislas.cloud",
        "AUTH_RP_NAME": "Larafeed",
        "AUTH_CHALLENGE_TTL_SECONDS": "300",
        "AUTH_SESSION_TTL_SECONDS": "2592000"
    },
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "larafeed",
            "database_id": "00000000-0000-0000-0000-000000000001",
            "migrations_dir": "migrations"
        }
    ],
    "ratelimits": [
        {
            "name": "AUTH_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 20, "period": 60 }
        }
    ],
    "env": {
        "test": {
            "vars": {
                "AUTH_ENVIRONMENT": "test",
                "AUTH_RP_ID": "larafeed-test.stanislas.cloud",
                "AUTH_ORIGIN": "https://larafeed-test.stanislas.cloud",
                "AUTH_RP_NAME": "Larafeed Test",
                "AUTH_CHALLENGE_TTL_SECONDS": "300",
                "AUTH_SESSION_TTL_SECONDS": "2592000"
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "larafeed-test",
                    "database_id": "00000000-0000-0000-0000-000000000002",
                    "migrations_dir": "migrations"
                }
            ],
            "ratelimits": [
                {
                    "name": "AUTH_RATE_LIMITER",
                    "namespace_id": "1002",
                    "simple": { "limit": 1000, "period": 60 }
                }
            ]
        }
    }
}
