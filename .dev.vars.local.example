# Copy to .dev.vars for local Worker development only.
AUTH_ENVIRONMENT="development"
AUTH_ORIGIN="http://localhost:5173"
AUTH_RP_NAME="Larafeed Local"
AUTH_CHALLENGE_TTL_SECONDS="300"
AUTH_SESSION_TTL_SECONDS="2592000"
AUTH_OPERATOR_SECRET="local-operator-secret-change-me"
AI_SUMMARY_ENABLED="false"
AI_GATEWAY_NAME="larafeed-local"
AI_MODEL="gemini-2.5-flash"
REFRESH_SCHEDULER_ENABLED="true"
REFRESH_DISPATCH_ENABLED="true"
REFRESH_DUE_LIMIT="5"
OPML_IMPORT_ENABLED="true"
FAVICON_REFRESH_ENABLED="true"
IMAGES_ENABLED="true"
FEED_REFRESH_QUEUE_NAME="larafeed-feed-refresh"
OPML_IMPORT_QUEUE_NAME="larafeed-opml-import"
FAVICON_REFRESH_QUEUE_NAME="larafeed-favicon-refresh"
TURNSTILE_ENABLED="false"
# To enable optional local integrations, add their credentials explicitly.
# TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# AI_GATEWAY_ACCOUNT_ID="00000000000000000000000000000000"
# GEMINI_API_KEY="local-gemini-key-change-me"
